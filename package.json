{
  "name": "ryan",
  "version": "1.0.0",
  "description": "Lumen e-learning",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"next dev renderer\" \"set NODE_ENV=development&& wait-on http://localhost:3000 && electron .\"",
    "dev:web": "next dev renderer",
    "build": "next build renderer",
    "build:renderer": "next build renderer",
    "dist:win": "npm run build:renderer && electron-builder --win --dir",
    "start": "next start renderer",
    "electron": "NODE_ENV=development electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.ryan.lumen",
    "productName": "Lumen",
    "files": [
      "main/**/*",
      "renderer/out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@livekit/components-react": "^2.9.21",
    "@supabase/supabase-js": "^2.49.4",
    "livekit-client": "^2.10.1",
    "livekit-server-sdk": "^2.13.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "concurrently": "^9.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^22.14.13",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wait-on": "^9.0.10"
  }
}
